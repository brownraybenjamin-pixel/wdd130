ck if you need to contact the bank about a Positive Pay file that may have already been sent<\/li><li>Run the Payroll Edit Detail Listing and Pre-Check Detail Listing reports to capture pay statement values before editing<\/li><\/ul>",lstrEditProfile="Edit Profile",lstrEditProfileValuesOnHCMStandardProfilePage="You can edit the profiles in Pro WFM on the HCM standard profile page within",lstrEditRecord="Edit Record",lstrEditRow="Edit row",lstrEditSsnNotValid="lstrEditSsnNotValid";Messages[lstrEditSsnNotValid]=["The SSN, {0}, is not a valid number.  Enter a valid SSN.",Log.ERR];lstrEditTimeInWFM="To edit the time fields for this employee, go to the Workforce Management module in UKG Pro.";lstrEducationLevelCannotBeNone="lstrEducationLevelCannotBeNone";Messages[lstrEducationLevelCannotBeNone]=["An education level is required for each education major. Education level cannot be 'None'. Please select a valid education level.",Log.ERR];lstrEducationLevelMejorCombinationExists="lstrEducationLevelMejorCombinationExists";Messages[lstrEducationLevelMejorCombinationExists]=["This education level and major combination has already been assigned. Please select a different education level or major.",Log.ERR];lstrEducationLevelMejorCombinationExistsWithCode="lstrEducationLevelMejorCombinationExistsWithCode";Messages[lstrEducationLevelMejorCombinationExistsWithCode]=["Duplicate education and major combinations are not allowed: {0}.",Log.ERR];lstrEEO1_Sentence_ChangingHeadquarters="lstrEEO1_Sentence_ChangingHeadquarters";Messages[lstrEEO1_Sentence_ChangingHeadquarters]=["Selecting this establishment as the Headquarters will override the prior Headquarters designation.",Log.INFO];lstrEEO1_Sentence_FileCouldNotBeCreated="lstrEEO1_Sentence_FileCouldNotBeCreated";Messages[lstrEEO1_Sentence_FileCouldNotBeCreated]=["Your data file could not be created. Please contact your system administrator.",Log.ERR];lstrEEO1_Sentence_FileHasBeenCreated="lstrEEO1_Sentence_FileHasBeenCreated";Messages[ls