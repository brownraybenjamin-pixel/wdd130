n 50 employees. NOTE: If you are switching between a detailed report (Type 8) and a summary report (Type 6) for establishments with fewer than 50 employees, you will need to send a request by email with your company name and company ID number to <a href="mailto:{0}" target="_top">{0}<\/a>.<\/p>',lstrEEPayCapMsg="lstrEEPayCapMsg";Messages[lstrEEPayCapMsg]=["Employee pay period cap must be entered.",Log.ERR];lstrEeShareOfLowestCostMonthlyPremium="Employee share of lowest-cost monthly premium for self-only coverage";lstrEEType="lstrEEType";Messages[lstrEEType]=["Employee Type",Log.INFO];lstrEffDateNeeded="lstrEffDateNeeded";Messages[lstrEffDateNeeded]=["An effective date must be added before a pay scale or salary step is chosen",Log.ERR];var lstrEffectiveDate="Effective date",lstrEffectiveDateAdjustmentWarningText="You're making an adjustment that may be prevented if the effective date precedes the employee's timesheet manager sign off date.",lstrEffectiveDateAfterCurrentErrorText="Choose an effective date that is after the start date of the current value.",lstrEffectiveDateAfterHireDate="Choose an effective date that is after the employee's hire date.",lstrEffectiveDateAfterJobStartDate="Choose an effective date that is on or after the employee's job start date.",lstrEffectiveDateAfterPrev="Choose an effective date that is after the start date of the previous value.",lstrEffectiveDateAfterPrimaryDate="Choose an effective date that is after the employee's primary record effective date.",lstrEffectiveDateAppliedTo="Effective Dating: All changes to this record will be applied on",lstrEffectiveDateAppliedToBenGrp="Effective Dating: All changes to Deduction/Benefit Plans assigned to this group will be applied on",lstrEffectiveDateBeforeCurrent="Choose an effective date that is before the effective date of the current value.",lstrEffectiveDateChangesDateTo="Change the effective date to",lstrEffectiveDateChangesNotAppliedUntil="Any changes made will not be applied in the sys