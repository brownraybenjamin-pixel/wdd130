d select override, if needed.",lstrSmartTaxSearch_Sentence_AcknowledgeConsent="Notwithstanding anything to the contrary in any agreements, as an individual with a designated role of “Corporate Officer” in UKG Pro, I acknowledge that I have the authority to agree to the below usage terms and consent to enable the Smart Tax Search feature on behalf of my business. I acknowledge and agree that UKG Inc. can access my company’s address data (which may be confidential) using geographic information system technology. Address data submitted is not linked to a particular customer or employee, or stored by a third-party. Address data is only used to obtain geographic details, such as latitude and longitude coordinates, to map tax codes in UKG Pro to the jurisdictional boundary to which the address belongs.",lstrSmartTaxSearch_Sentence_NoAccessRights="You do not have access rights to edit this page.",lstrSmartTaxSearchStructureNumberMissing="Address cannot be located due to missing house or building number in Address Line 1.",lstrSocialInsuranceNumber="Social insurance number",lstrSocialSecurity="Social Security",lstrSomeAccrualsValidation="lstrSomeAccrualsValidation";Messages[lstrSomeAccrualsValidation]=["At least one accrual must be selected for Accrual Include.",Log.ERR];lstrSomeAccrualsValidation2="lstrSomeAccrualsValidation2";Messages[lstrSomeAccrualsValidation2]=['When selecting all accruals change "Accrual Include" option to "All".',Log.ERR];lstrSomeBPsAreCopied="One or more of the selected business processes is already a copy of another business process. Please deselect the copied business process to continue";lstrSomethingWentWrongErrorMsg="lstrSomethingWentWrongErrorMsg";Messages[lstrSomethingWentWrongErrorMsg]=["Something went wrong",Log.ERR];var lstrSpanish="Spanish (USA)",lstrSPBExceptionGroupEmployeeCount="{0} Employees",lstrSPBExceptionGroupQualifiersEECount="Selected qualifiers result in <a>{0} employees<\/a>.",lstrSPBExceptionGroups_ViewEmployees="View Employees",lstrSPBProrationPeriodLengthTooLong="The proration period of the selected rule is greater than 3 years. Select a proration rule whose proration period is less than 3 years.",lstrSPBProrationPeriodLengthTooShort="The proration period of the selected rule is less than the salary plan period. Select a proration rule whose proration period is greater than or equal to the salary plan period.",lstrSpent="Spent",lstrSpouse="Spouse",lstrSpouseConditionalOfferedCoverage="Coverage is conditionally offered to spouse",lstrSPWDeletedGroupsConfirmation="{0} employee group(s) were successfully deleted.",lstrSPWEEGroupsDeleteGroupConfirmation="Would you like to remove the selected employee group(s)?",lstrSPWEmployeeGroupsCancelConfirmation="Are you sure you would like to cancel?",lstrSQLTimeout="lstrSQLTimeout";Messages[lstrSQLTimeout]=["The selected records exceed the maximum amount that can be processed at one time. Refine the filters to reduce the number of records.",Log.ERR];lstrSRDetailExpirationError="lstrSRDetailExpirationError";Messages[lstrSRDetailExpirationError]=["The expiration date must be greater than today's date",Log.ERR];var lstrSSEEDeferralNotAllowed="Your employer has not allowed the deferral of employee social security taxes. You will not have the option to elect this deferral until your employer has enabled it.",lstrSSN="SSN",lstrSsnIsNotUnique="lstrSsnIsNotUnique";Messages[lstrSsnIsNotUnique]=["The social security number entered already exists for another employee.",Log.ERR];var lstrSSNNotValid="The SSN, {0}, is not a valid number.  To continue hiring this employee, enter a valid SSN.",lstrSSOAPFileImportInfoMsgNoCompCode="The file imported must be of type csv, where the first column is the Employee Identifier and the second column is the desired Client User Name (UPN) value (if applicable).",lstrSSOAPFileImportInfoMsgYesCompCode="The file imported must be of type csv, where the first column is the Employee Identifier, the second column is the Company Code